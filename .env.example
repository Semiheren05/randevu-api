# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=1h
CORS_ALLOWED_ORIGINS=http://localhost:5500
# Optional: booking confirmation / cancellation emails (SMTP, e.g. a Gmail app password)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATION_MAIL_FROM=
# Reminder emails the day before an appointment (needs the mail settings above)
BOOKING_REMINDERS_ENABLED=true
# Online payment: none (pay at the business), stripe (test mode with sk_test_ keys)
PAYMENT_PROVIDER=none
PAYMENT_SUCCESS_URL=http://localhost:5500/odeme-basarili
PAYMENT_CANCEL_URL=http://localhost:5500/odeme-iptal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
